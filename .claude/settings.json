  "permissions": {
    "deny": [
      "Edit(.env)",
      "Write(.env)",
      "Read(.env)",
      "Edit(.env.production)",
      "Write(.env.production)",
      "Read(.env.production)",
      "Edit(.env.local)",
      "Write(.env.local)",
      "Read(.env.local)",
      "Edit(.env.sentry-build-plugin)",
      "Write(.env.sentry-build-plugin)",
      "Read(.env.sentry-build-plugin)",
      "Edit(.mcp.json)",
      "Write(.mcp.json)",
      "Read(.mcp.json)",
      "Bash(cat .env:*)",
      "Bash(cat .env.production:*)",
      "Bash(cat .env.local:*)",
      "Bash(cat .env.sentry-build-plugin:*)",
      "Bash(cat .mcp.json:*)",
      "Bash(type .env:*)",
      "Bash(type .env.production:*)",
      "Bash(type .env.local:*)",
      "Bash(type .env.sentry-build-plugin:*)",
      "Bash(type .mcp.json:*)",
      "Bash(more .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "PowerShell(Get-Content .env:*)",
      "PowerShell(Get-Content .env.production:*)",
      "PowerShell(Get-Content .env.local:*)",
      "PowerShell(Get-Content .env.sentry-build-plugin:*)",
