generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// NextAuth adapter models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  createdLeagues        League[]             @relation("LeagueCreator")
  memberships           LeagueMember[]
  picks                 Pick[]
  tiebreakerResponses   TiebreakerResponse[]
}

model League {
  id          String   @id @default(cuid())
  name        String
  sport       String?
  inviteCode  String   @unique @default(cuid())
  createdById String
  description String?
  maxMembers  Int?
  isPrivate   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User           @relation("LeagueCreator", fields: [createdById], references: [id])
  members   LeagueMember[]
  games     Game[]
  slates    Slate[]

  @@index([createdById])
}

model LeagueMember {
  id       String   @id @default(cuid())
  userId   String
  leagueId String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
  @@index([leagueId])
}

// SportGame holds the app-managed canonical schedule per sport.
// Leagues draw from this table when slates are built; games are not
// created per-league from scratch.
model SportGame {
  id          String   @id @default(cuid())
  sport       String
  homeTeam    String
  awayTeam    String
  scheduledAt DateTime
  season      String
  espnId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sport])
  @@index([scheduledAt])
}

// Slate groups games within a league into a named round.
// Only one slate per league has status "active" at a time.
// status: "upcoming" | "active" | "completed"
model Slate {
  id        String   @id @default(cuid())
  leagueId  String
  name      String
  position  Int
  status    String   @default("upcoming")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league              League               @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  games               Game[]
  tiebreakerQuestions TiebreakerQuestion[]

  @@unique([leagueId, position])
  @@index([leagueId])
}

model Game {
  id          String   @id @default(cuid())
  leagueId    String
  slateId     String?
  homeTeam    String
  awayTeam    String
  startTime   DateTime
  homeScore   Int?
  awayScore   Int?
  status      String   @default("scheduled")
  espnGameId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  slate  Slate?  @relation(fields: [slateId], references: [id])
  picks  Pick[]

  @@index([leagueId])
  @@index([startTime])
  @@index([slateId])
}

model Pick {
  id         String   @id @default(cuid())
  userId     String
  gameId     String
  pickedTeam String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

// TiebreakerQuestion belongs to a Slate. answer is nullable until the admin
// records the correct value after the slate is complete.
model TiebreakerQuestion {
  id        String   @id @default(cuid())
  slateId   String
  question  String
  answer    Int?
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slate     Slate                @relation(fields: [slateId], references: [id], onDelete: Cascade)
  responses TiebreakerResponse[]

  @@index([slateId])
}

// TiebreakerResponse records one member's numeric guess for one question.
model TiebreakerResponse {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  response   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  question TiebreakerQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([questionId])
}
